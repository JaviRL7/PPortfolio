---
import Layout from '../layouts/Layout.astro';
import Texto from '../components/Texto.astro';
import Navbar from '../components/Navbar.astro';
import Imagen from '../components/Imagen.astro';
---

<Layout title="Welcome to Astro">
  <main class="relative">
    <!-- Texto principal animado -->
    <Texto id="main-text" />
    <!-- Imagen de fondo detrás del texto -->
    <div id="background-image" class="image-visible absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] h-[70%]">
      <Imagen src="/javi3.jpg" alt="Imagen de fondo" />
    </div>
    <!-- Navbar que aparecerá después de la imagen -->
    <div id="navbar" class="navbar-visible">
      <Navbar />
    </div>
    <!-- Secciones adicionales -->
    <section id="section-2" class="hidden">
      <div class="text-animation relative z-20">
        <h1>Ejemplo 2</h1>
        
        
      </div>
      <div class="image-visible absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] h-[70%]">
        <img src="javi2.jpg" alt="Imagen de fondo 2" class="object-cover w-full h-full" />
      </div>
    </section>
    <section id="section-3" class="hidden">
      <div class="text-animation relative z-20">
        <h1>Ejemplo 3</h1>
        <img src="/javi3.jpg" alt="Imagen de fondo 3" class="object-cover w-full h-full" />
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentSection = 0; // Mantiene el seguimiento de la sección actual
    const sections = [
      { id: 'background-image', imgSrc: '/javi2.jpg', bgColor: '#007bff', textColor: '#fff', text: 'Hola, soy Javi' },
      { id: 'section-2', imgSrc: '/javi1.jpg', bgColor: '#6c757d', textColor: '#fff', text: 'Ejemplo 2' },
      { id: 'section-3', imgSrc: '/javss.jpg', bgColor: '#28a745', textColor: '#fff', text: 'Ejemplo 3' },
    ];

    const changeSection = (direction: number) => {
      currentSection += direction;
      if (currentSection < 0) currentSection = 0;
      if (currentSection >= sections.length) currentSection = sections.length - 1;

      const section = sections[currentSection];
      const mainContent = document.querySelector('main');
      const navbar = document.querySelector('#navbar');
      const backgroundImage = document.querySelector('#background-image img');
      const mainText = document.querySelector('#main-text h1');

      if (mainContent instanceof HTMLElement && navbar instanceof HTMLElement && backgroundImage instanceof HTMLImageElement && mainText instanceof HTMLElement) {
        mainContent.style.backgroundColor = section.bgColor;
        navbar.style.color = section.textColor;
        mainText.textContent = section.text;
        backgroundImage.src = section.imgSrc;

        sections.forEach((sec, index) => {
          const secElement = document.getElementById(sec.id);
          if (secElement) {
            secElement.classList.toggle('hidden', index !== currentSection);
          }
        });
      }
    };

    window.addEventListener('wheel', (event) => {
      if (event.deltaY > 0) {
        changeSection(1); // Desplazar hacia abajo
      } else {
        changeSection(-1); // Desplazar hacia arriba
      }
    });

    let touchStartY = 0;
    window.addEventListener('touchstart', (event) => {
      touchStartY = event.touches[0].clientY;
    });

    window.addEventListener('touchend', (event) => {
      const touchEndY = event.changedTouches[0].clientY;
      if (touchEndY < touchStartY) {
        changeSection(1); // Deslizar hacia arriba
      } else {
        changeSection(-1); // Deslizar hacia abajo
      }
    });
  });
</script>

<style>
  .hidden {
    display: none;
  }

  .navbar-visible {
    opacity: 1;
    transition: opacity 1s ease-in-out;
  }

  .image-visible {
    opacity: 1;
    transition: opacity 1s ease-in-out;
  }

  .section img {
    max-width: 100%;
    height: auto;
  }

  main {
    transition: background-color 0.5s ease-in-out;
  }

  h1 {
    color: inherit;
  }
</style>
