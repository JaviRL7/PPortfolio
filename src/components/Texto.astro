<div class="text-animation relative z-20" id="main-text">
  <h1>
    {Array.from("Hola, soy Javi").map((char, index) => (
      <span style={`animation-delay: ${index * 0.1}s;`} class="char">
        {char === " " ? '\u00A0' : char}
      </span>
    ))}
  </h1>
</div>

<style>
  /* Fuente Inter */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');

  .text-animation {
    font-family: 'Inter', sans-serif; /* Aplicar la fuente Inter */
    font-size: 4rem; /* Aumentar el tamaño de la fuente */
    display: flex;
    justify-content: flex-start; /* Alinea hacia la izquierda */
    align-items: center;
    height: 100vh;
    padding-left: 10%; /* Mover más a la izquierda */
    z-index: 20; /* Asegura que el texto quede por encima de la imagen */
  }

  .text-animation span {
    opacity: 0;
    animation: fadeIn 0.5s forwards;
    display: inline-block; /* Para asegurarse de que se respete el espaciado */
    font-weight: 700;
  }

  /* Animación de aparición de letras */
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
